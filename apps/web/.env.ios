# Loaded by `vite build --mode ios` (Vite's standard .env.[mode] handling).
# Inside the Capacitor shell the app runs at capacitor://localhost, so every
# API/media/socket request must carry the absolute production origin.
VITE_API_BASE=https://pulse.geddo.online

# Ad pixels are deliberately NOT set for the iOS build (App Tracking
# Transparency — don't load FB/TikTok pixels in the native shell).
