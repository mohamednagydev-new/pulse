# Ad pixel IDs — PUBLIC identifiers (visible in page source by design), safe to commit.
# Fill these and rebuild/redeploy to activate signup-optimized ad campaigns.
# Empty value = that pixel never loads (no script, no requests).
#
# Meta:   business.facebook.com → Events Manager → Data sources → create/select Pixel → copy ID
# TikTok: ads.tiktok.com → Assets → Events → Web events → create Pixel → copy ID
# Google: ads.google.com → Goals → Conversions → new "Sign-up" action (website) →
#         tag setup gives you AW-XXXXXXXXX and a conversion LABEL
VITE_FB_PIXEL_ID=2228033330935037
VITE_TIKTOK_PIXEL_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_SIGNUP_LABEL=
