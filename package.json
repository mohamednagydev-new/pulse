{
  "name": "fit-it",
  "private": true,
  "version": "0.1.0",
  "description": "FIT IT — fitness content PWA (React + Express + SQLite)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm -w apps/api run dev",
    "dev:web": "npm -w apps/web run dev",
    "build": "npm -w apps/api run build && npm -w apps/web run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:users": "tsx prisma/seed-users.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:studio": "prisma studio",
    "ai:translate": "tsx prisma/translate.ts",
    "ai:embed": "tsx prisma/embed.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "pptxgenjs": "^4.0.1",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1"
  }
}
