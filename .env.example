# ---- Database (SQLite via Prisma) ----
DATABASE_URL="file:./dev.db"

# ---- API server ----
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-access-secret
# (Refresh tokens are random bytes hashed in the DB, not JWTs — no refresh secret exists.)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Signs time-limited /media URLs. Separate from the JWT secret so rotating one
# does not invalidate the other. Falls back to JWT_ACCESS_SECRET when blank.
MEDIA_SIGN_SECRET=

# ---- Media storage ----
UPLOAD_DIR=../../uploads
# Nightly SQLite backups land here (04:00, keeps 14). Point at a mounted or
# cloud-synced drive to make them off-site. Blank = <repo>/backups.
BACKUP_DIR=
# Optional: path to ffmpeg/ffprobe if not on PATH
FFMPEG_PATH=
FFPROBE_PATH=

# ---- OAuth (Phase 3) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Reels ----
# Reels are added by pasting a YouTube link in Admin -> Reels -> "Add by link".
# That path uses YouTube's own oEmbed endpoint: no key, no quota, nothing that can go
# dark. Playback is a youtube-nocookie embed addressed by video id, so reel URLs no
# longer expire, and YouTube refuses to embed age-restricted videos — so an unsafe
# video is rejected rather than imported unchecked.
#
# TikTok was removed entirely (scraper fragility, expiring CDN URLs, and an embed that
# handed users into an algorithmic feed we do not control). There is no reels env var.

# ---- OpenAI — OPTIONAL. Everything below degrades cleanly when the key is blank. ----
#
# What it turns on:      coach chat (grounded in our own articles), semantic search,
#                        the natural-language calorie estimator, and the admin
#                        "estimate macros from ingredients" button.
# What it does NOT do:   the training plan and the meal plan are rule-based and stay
#                        that way. They must be explainable, so no model issues them.
#
# Cost is bounded by a per-user daily allowance in apps/api/src/lib/aiBudget.ts,
# not by this key. Read that file before raising anything.
#
# After setting the key you MUST run the indexer, or chat and search have no content
# to stand on and the coach quietly becomes generic ChatGPT:
#   node node_modules/tsx/dist/cli.mjs prisma/embed.ts
# deploy/seed.ps1 runs it for you as its last step.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Email (SMTP) — REQUIRED for password reset, weekly digest, admin blasts ----
# Blank SMTP_HOST = every email is silently dropped (logged to console only).
# The admin Email page shows a red banner + real send errors when this is off.
# Gmail:   smtp.gmail.com, port 587, secure=false, app-password (not your login
#          password — create one at https://myaccount.google.com/apppasswords).
# Brevo (free 300/day): smtp-relay.brevo.com, port 587, secure=false.
# SMTP_FROM should be an address on a domain you control (SPF/DKIM), else Gmail
# and Outlook may drop the mail with no bounce and no spam-folder copy.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@fitit.app

# ---- Wearables (Strava hub — see WEARABLES.md) ----
# Create a free API app at https://www.strava.com/settings/api
# Blank = the Connected-devices section stays hidden in the app.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; used once when registering the webhook subscription.
STRAVA_VERIFY_TOKEN=

# ---- Stripe (Phase 4) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Facebook Page auto-posting (weekly league celebration; optional) ----
FB_PAGE_ID=
FB_PAGE_TOKEN=
