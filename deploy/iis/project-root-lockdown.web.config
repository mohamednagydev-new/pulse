<?xml version="1.0" encoding="UTF-8"?>
<!--
  ONLY needed if the project sits INSIDE the IIS web root, e.g. C:\inetpub\wwwroot\pulse.
  Copy this file to the PROJECT ROOT as web.config, i.e.:
      C:\inetpub\wwwroot\pulse\web.config

  Why: your existing Default Web Site serves everything under wwwroot, so without this a
  request like http://<server>/pulse/.env would hand out your secrets / database / source.
  This returns 403 for any request that reaches the project folder through another site.

  It does NOT affect the "pulse" site itself — that site is rooted deeper (apps\web\dist),
  which has its own web.config, so IIS never applies this file to it.

  (Better still: keep the project at C:\pulse, outside the web root, and you don't need this.)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="BlockProjectRoot" stopProcessing="true">
          <match url=".*" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
